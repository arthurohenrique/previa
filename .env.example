# Copie para .env.local e preencha. Nunca commite .env.local.

# Públicas — chegam ao browser por design (anon key é protegida por RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. NUNCA prefixe com NEXT_PUBLIC_. Ignora RLS: usada apenas em
# rotas de servidor e em scripts de teste de isolamento entre clínicas.
SUPABASE_SERVICE_ROLE_KEY=

# Versão do termo de consentimento em vigor. Fica gravada em consents.terms_version
# para que uma revisão futura do texto não reescreva o que o paciente assinou.
NEXT_PUBLIC_TERMS_VERSION=2026-08-01
