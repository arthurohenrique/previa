# Copie para .env.local e preencha. Nunca commite .env.local.

NEXT_PUBLIC_SUPABASE_URL=

# Chave pública do projeto. Aceita os dois formatos:
#   - `sb_publishable_…`  chave publicável, formato atual do Supabase
#   - JWT `anon`          formato legado, em NEXT_PUBLIC_SUPABASE_ANON_KEY
# Ela identifica o projeto, não autoriza nada: quem protege os dados é a RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Versão do termo de consentimento em vigor. Fica gravada em
# consents.terms_version para que uma revisão futura do texto não reescreva o
# que o paciente assinou. Sem ela, o registro nasce com "sem-versao".
NEXT_PUBLIC_TERMS_VERSION=2026-08-01
